{
  "name": "deck",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev slides.md",
    "build": "slidev build slides.md --out dist",
    "build:base": "slidev build slides.md --base /seah-ax-deck/ --out dist && node scripts/strip-dead-preload.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "qa": "node scripts/visual-qa.mjs",
    "qa:gate": "node scripts/visual-qa.mjs --check-review",
    "capture": "node scripts/capture-steps.mjs",
    "annotate": "node scripts/annotate-steps.mjs"
  },
  "dependencies": {
    "@slidev/cli": "52.15.2",
    "@slidev/theme-default": "0.25.0",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright-chromium": "^1.60.0",
    "playwright-core": "^1.60.0",
    "sharp": "^0.34.0"
  },
  "pnpm": {
    "overrides": {
      "@slidev/client": "52.15.2",
      "entities": "7.0.1"
    }
  }
}
